# Keep beside api.php with the supplied web-server deny rules, or use CODECLEAR_ENV_FILE.
# Do not commit a populated .env.
GROQ_API_KEY=REPLACE_WITH_YOUR_PROVIDER_KEY
GROQ_MODEL=openai/gpt-oss-120b
CODECLEAR_CACHE_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
# Public mobile access needs no manually provisioned client token.
# Installation identifiers isolate private caches; they do not authenticate official clients.
CODECLEAR_ALLOW_ANONYMOUS=true
CODECLEAR_ANONYMOUS_RPM=120
CODECLEAR_NETWORK_RPM=30
# Optional legacy clients: php api.php generate-token; store only SHA-256 digests here.
CODECLEAR_CLIENT_TOKENS='{}'
# Optional absolute path. Omit to use the protected adjacent data/cache.sqlite3.
# CODECLEAR_DB_PATH=/srv/codeclear-private/cache.sqlite3
CODECLEAR_REQUIRE_HTTPS=true
CODECLEAR_CACHE_DAYS=30
CODECLEAR_CACHE_ENTRIES=2000
CODECLEAR_CLIENT_RPM=60
CODECLEAR_PROVIDER_RPM=10
CODECLEAR_PROVIDER_RPD=500
CODECLEAR_PROVIDER_CONCURRENCY=2
